  "boundary_evidence": {
    "start": "StartUpROMTest begins at $400D76 after InitEvents. It sets the first test number in A4 before computing the ROM checksum.",
    "end": "The CrossMark row bitmap ends at $401036, where SysErrInit begins."
  },
  "edits": [
    {
      "kind": "source_restoration",
      "description": "Restored the startup checksum, memory tests, icon decoder, display helpers, and data through $401036. The evidence records 27 matching released operations and 146 ROM-only operations. The emitted span contains 432 instruction bytes and 272 data bytes."
    },
    {
      "kind": "test_restoration",
      "description": "Restored the older combined test entry, address alias test, RAM sizing, and memory pattern passes. The released STCritTests.a has a changed checksum register layout and rewritten memory tests, so the missing operations are identified explicitly."
    },
    {
      "kind": "display_restoration",
      "description": "Restored fixed screen addresses, the 64-byte row stride, and the DeadMac, HappyMac, and PutSymbol bodies. StartFail.a records the removal of the older Mac Plus display helpers in June 1989."
    },
    {
      "kind": "data_provenance",
      "description": "Preserved the ROM memory pattern table and compressed Mac and disk outlines. The compressed images each consume their complete data span and expand to 32-by-32 pixels. The two faces and two disk symbols match the middle 16 bits of rows in the released HappyIcon, SadMacIcon, QDiskIcon, and XDiskIcon data."
    },
    {
      "kind": "comment_preservation",
      "description": "Retained the original test and display file headers, PutIcon interface description, matching instruction comments, and icon decoding comments. Omitted obsolete checksum chip-layout comments and a branch comment whose destination changed."
    }
  ],
