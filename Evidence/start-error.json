  "boundary_evidence": {
    "start": "SysErrInit begins at $401036 after the startup icon data.",
    "end": "The final exception return is RTE at $4011AA. AllocFakeRgns begins at $4011AC."
  },
  "edits": [
    {
      "kind": "scope",
      "description": "Restored the complete SysErrInit, Debugger, hardware exception receivers, and SystemError sequence. Retained the original header, history through November 1985, applicable contracts, equates, and matching body comments."
    },
    {
      "kind": "restoration",
      "description": "Selected the released Mac Plus seRegs definition at $3FFC80. Restored all seven interrupt vectors to IRQException and installed the ROM serial debugger through MacJmp. Later source clears the debugger vector and adds a separate NMI handler."
    },
    {
      "kind": "restoration",
      "description": "Restored debugger state bits in the high byte of MacJmp and masked those bits before jumping through it. Later source moves the flags into MacJmpFlag for 32-bit addressing. Retained the original register save area and exception-frame restoration."
    },
    {
      "kind": "restoration",
      "description": "Removed later parity checks, patch-error remapping, and nil-debugger guards. The ROM passes debugger errors to DSErrorHandler and returns through RTE using SEPC and SESR."
    },
    {
      "kind": "build",
      "description": "The ROM controls instruction widths, branch destinations, and procedure boundaries. Each source correspondence records an operation from the same routine, which may have changed encoding or target in the later source. Every instruction is assembled without data placeholders."
    }
  ],
