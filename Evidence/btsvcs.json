  "changes": [
    {
      "location": "BTDelete",
      "change": "Removed the November 1985 parent-read error check and repeated root reduction. Restored MOVE.W D2,D3 before the May 1989 fix and removed later write-count updates.",
      "evidence": "The GetNode call at 0x40680a is followed directly by MOVEA.L A0,A2. The parent node number moves as a word at 0x406846. Root reduction ends after FreeNode at 0x40689e."
    },
    {
      "location": "BTInsert",
      "change": "Removed InitNode error checks added in December 1985 and write-count updates later integrated in April 1992.",
      "evidence": "The InitNode calls at 0x406a80 and 0x406bec proceed directly to saving their returned pointers. The insertion path at 0x406b02 marks the node without updating a write count."
    },
    {
      "location": "BTFlush",
      "change": "Restored the offline return without clearing D0 and the NOP following FlushCache.",
      "evidence": "The branch at 0x4068dc goes to BFExit at 0x40691e. NOP at 0x40691c occupies the former branch to the next instruction."
    },
    {
      "location": "BTOpen and CalBTVars",
      "change": "Restored the 54-byte BTCB allocation, omitted the later write-count signature, and removed the extra four bytes added to CalBTVars in January 1986.",
      "evidence": "BTOpen allocates 54 bytes with the system-heap cleared-pointer trap. CalBTVars adds lenTPT, 48 bytes, to the maximum key size at 0x406e32."
    },
    {
      "location": "Source provenance and instruction forms",
      "change": "Preserved the original header, applicable history, and comments. Added original equates, explicit trap opcodes, external addresses, and instruction forms matching the ROM.",
      "evidence": "All 1884 bytes and 21 labels match. The NewPtr system and clear modifiers are represented by the named opcode 0xa71e. Short and word branches, quick arithmetic, and CLR.B preserve the target encodings."
    }
  ],
