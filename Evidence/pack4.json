          "definition": "NANSQRT \t\tEQU \t\t1\t\t\t\t\t\t; Invalid square root such as sqrt(-1)."
        },
        {
          "line": 1584,
          "definition": "NANADD\t\t\tEQU \t\t2\t\t\t\t\t\t; Invalid addition such as +INF - +INF."
        },
        {
          "line": 1585,
          "definition": "NANDIV\t\t\tEQU \t\t4\t\t\t\t\t\t; Invalid division such as 0/0."
        },
        {
          "line": 1586,
          "definition": "NANMUL\t\t\tEQU \t\t8\t\t\t\t\t\t; Invalid multiply such as 0 * INF."
        },
        {
          "line": 1587,
          "definition": "NANREM\t\t\tEQU \t\t9\t\t\t\t\t\t; Invalid remainder or mod such as x REM 0."
        },
