  "edits": [
    {
      "kind": "extraction",
      "description": "Retained the complete region module from StdRgn through MapRgn. Omitted BitMapRgn, whose May 18, 1989 addition appears in the ancestor history."
    },
    {
      "kind": "comments",
      "description": "Preserved the region title, routine documentation and instruction comments. Removed the later EASE header and added separate reconstruction notes."
    },
    {
      "kind": "equates",
      "description": "Replaced the later GrafTypes include with its required equates and their dependencies. Selected the Mac Plus xToolTable value of $C00. Retained the original procedure parameters and local EQU declarations."
    },
    {
      "kind": "macro_reversion",
      "description": "Retained every UNLINK invocation and restored a 68000 macro definition. For four parameter bytes, the ROM moves (SP)+ to (SP) and returns. For other nonzero sizes, it pops the return address into A0, adjusts SP and jumps through A0. The later GrafTypes macro uses a different sequence."
    },
    {
      "kind": "addressing",
      "description": "Made PC addressing explicit for every direct JSR and JMP. Associated the 52 source call operands with the 52 ROM call targets in order; repeated targets agree. External procedure EQU values record those targets."
    },
    {
      "kind": "instruction_encoding",
      "description": "Made the ROM quick encodings explicit: nonzero small MOVE.L constants become MOVEQ, the zero constant in EqualRgn becomes CLR.L, and immediate ADD or SUB instructions become ADDQ or SUBQ where applicable. Unsuffixed local branches use their ROM short encodings."
    },
    {
      "kind": "instruction_encoding",
      "description": "Replaced the final FillRgn and XorRgn branches to the following instruction with NOP, matching the ROM. The original comments remain beside those instructions."
    },
    {
      "kind": "trap",
      "description": "Defined _DisposHandle as OPWORD $A023. Every call retains its original symbolic spelling."
    }
  ],
