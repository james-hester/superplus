    {
      "kind": "extraction",
      "description": "Retained Delay, CmpString, RelString, Canonizer, EntString, ExtString, UprString and all three tables. Other SysUtil routines remain outside this excerpt."
    },
    {
      "kind": "instruction_reversion",
      "description": "Restored MOVE.W #$2000,SR in Delay, matching ROM bytes 46fc2000. The January 29, 1993 history entry identifies the later NuKernel change to ANDI.W #$F8FF,SR."
    },
    {
      "kind": "instruction_reversion",
      "description": "Restored BGT.S in Delay, matching ROM bytes 6efa. The June 21, 1993 history entry identifies the later change to unsigned BHI.S."
    },
    {
      "kind": "placement_reversion",
      "description": "Moved UprString after ExtString and restored its short BSR.S EntString and BRA.S ExtString. The February 28, 1989 comment records removal of those short branch suffixes in the ancestor."
    },
    {
      "kind": "symbol_reversion",
      "description": "Removed the Trap suffix from DelayTrap, RelStringTrap and UprStringTrap. The May 21, 1992 history entry records the suffix addition for RelString and UprString; Ghidra names the ROM Delay and UprString entries without that suffix."
    },
    {
      "kind": "assembly_directive",
      "description": "Added Ticks=$016A and closing directives. Made the original implicit PC addressing explicit for StripTab, UpperTab and CmpTab. Renamed local @1 labels to @DelayLoop and @CmpDone for translation."
    },
    {
      "kind": "comments",
      "description": "Retained the original header, copyright, history through 1985 and applicable routine comments. Removed later history, branch-change comments and the 1989 UpperTab bug-fix comments."
    },
    {
      "kind": "tables",
      "description": "Retained all nine original table macros and every table invocation. The UpperTab mapping from $60 to $61 remains unchanged. The extra $02 argument to basec for the nonbreaking space entry remains ignored, as in the original macro; CmpTab emits $20,$00 at that entry."
    }
  ],
