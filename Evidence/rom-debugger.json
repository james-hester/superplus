  "boundary_evidence": {
    "start": "The entry at $4017E0 is the ROMDebugger address installed by SysErrInit. It follows the final MicroBug branch.",
    "end": "The final RTS at $4019C8 chains to the saved Line-A handler. The NMI handler starts at $4019CA."
  },
  "edits": [
    {
      "kind": "missing_body_restoration",
      "description": "Restored the complete serial ROM debugger from 161 decoded instructions. No implementation using the surviving rdPort and rdAtrap variables was found in the released tree. HardwareEqu.a supplies the original variable layout, and StartErr.a supplies the caller interface."
    },
    {
      "kind": "data_restoration",
      "description": "Restored the six-entry command table as label differences and the eight SCC register-value pairs as byte data. These 28 bytes are data reached through explicit ROM references; instruction bytes are assembled from mnemonics."
    },
    {
      "kind": "symbol_restoration",
      "description": "Named routines and local branches according to their decoded behavior. These names are reconstructed, except for surviving variable names and the external WriteSCC and GenExcps names. Restored the Mac Plus seRegs value $3FFC80."
    },
    {
      "kind": "behavior_preservation",
      "description": "Preserved the original serial port checks, byte ordering, SCC delays, unchecked command dispatch, and optional Line-A trap range hook. No later debugger implementation was substituted."
    },
    {
      "kind": "comment_preservation",
      "description": "Retained the interface copyright, debugger variable section headings, original equate comments, and Debugger trap argument description. New notes identify inferred implementation details."
    }
  ],
