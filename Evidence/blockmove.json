  "edits": [
    {
      "kind": "scope",
      "description": "Restored the complete MC68000 BlockMove interval. The released history records removal of the 68000 versions in October 1991. The surviving tail operations supply 140 instruction and comment matches."
    },
    {
      "kind": "rom_reconstruction",
      "description": "Restored the entry, masked-address comparison, copy direction, mixed-alignment byte loops, aligned longword loops, and 48-byte MOVEM loops from the ROM. Every instruction is assembled; no instruction bytes are hidden in data directives."
    },
    {
      "kind": "source_preservation",
      "description": "Retained the released header, history through April 1985, argument and register description, tail comments, and matching instruction comments. The source note identifies the historical 124-byte threshold as obsolete for this ROM, whose MOVEM path requires at least 192 bytes after the alignment byte."
    },
    {
      "kind": "labels",
      "description": "Named tail entries by the byte counts in the ROM branch tables. Used explicit PC addressing and ROM branch widths. Newly named control labels describe reconstructed paths; they do not establish original source names."
    }
  ],
