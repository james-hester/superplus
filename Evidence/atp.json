  "changes": [
    {
      "description": "Retained the fake-header comments from PatchPlusROM because its flags, name and entry roles match this ROM. Restored the actual code offsets with label differences."
    },
    {
      "description": "Retained the unchanged SendRequest, SendResponse and ATPRead comments from the patch. Excluded comments that describe new listeners, interrupt guards or transaction checks absent from the ROM."
    },
    {
      "description": "Restored six outgoing request slots, six listening sockets and eight cached responses. The patch supplies TCBE, TSktNum, TQElPtr, VBLQEl and VBL60; the other private fields have descriptive reconstruction names."
    },
    {
      "description": "Restored three packet workspaces of 104 bytes. Each workspace contains an MPP parameter block, saved registers, return address, write-data structure and packet headers. IORefNum marks each workspace as busy."
    },
    {
      "description": "Retained the alternate application-heap allocation trap at $419DCE, although the preceding branch skips it during the ordinary Open path."
    },
    {
      "description": "Used named traps and symbolic packet, parameter, error and low-memory fields. Explicit instruction widths and PC modes preserve the ROM encoding. All data declarations belong to the resource header, driver header or dispatch table."
    }
  ],
  "preserved_rom_behavior": [
    {
      "address": "0x41a276",
      "description": "CheckTime calls GetDataArea before masking interrupts. PatchPlusROM describes its December 1986 fix with a dummy driver header and a guarded workspace call. The ROM retains the unguarded call."
    },
    {
      "address": "0x41a448",
      "description": "ReadResp reads a response into the caller buffer before validating its transaction ID. PatchPlusROM identifies delayed duplicate responses as able to overwrite valid response data. The source preserves this sequence and the original patch diagnosis."
    },
    {
      "address": "0x41a2a2",
      "description": "A retry count of $FF means repeated retries. CMP.B uses the positive immediate $FF so the unused high byte of its immediate word remains zero, as in the ROM."
    }
  ],
