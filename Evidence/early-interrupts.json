  "edits": [
    {
      "kind": "source_restoration",
      "description": "Restored the Mac Plus interrupt dispatchers from surviving InterruptHandlers.a and Clock.a operations. The evidence records 39 matching released operations and 27 ROM-only operations."
    },
    {
      "kind": "dispatch_restoration",
      "description": "Restored the original register saves and RTE exits, VIA bit scan, SCC vector indexing, and mouse external-status vector selection. The unconditional branch at $401A4A skips the SCSI test body retained in the ROM."
    },
    {
      "kind": "clock_order",
      "description": "Restored the ROM order that increments Time before clearing the VIA CA2 interrupt. Later Clock.a clears the interrupt first."
    },
    {
      "kind": "comment_preservation",
      "description": "Retained original file headers, SCC interface descriptions, clock descriptions, and applicable matching operation comments. Omitted the later SCC receive loop description and obsolete claim that mouse vectors are unused."
    }
  ],
