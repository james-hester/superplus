  "changes": [
    {
      "location": "FindDrive, CkExtFS, DtrmV3, and DtrmV2",
      "change": "Removed later dispatch stubs while retaining the original DtrmV1 vector. Omitted the later empty-name D2 fix.",
      "evidence": "The ROM enters the four routines directly. DtrmV1 pushes the vector at 0x0778 and returns; vDtrmV1 starts at 0x403656. DtrmV3 falls through to that vector for an empty string without clearing D2. FileMgrPatches.a describes FixDtrmV3 and the missing clear."
    },
    {
      "location": "Offline and eject",
      "change": "Restored synchronization at the shared Eject1 entry and cleared FlushOnly before closing HFS control files. Removed the later patch that keeps those files open.",
      "evidence": "Offline sets NoEject and branches; Eject clears it. Eject1 calls FSQueueSync at 0x4034e4. The mounted HFS path clears FlushOnly at 0x40355a and calls FlushBuffers. The surviving NoCloseOnOffline and NoCloseOnEject patches document the replacement policy."
    },
    {
      "location": "UnmountVol and FlushVol",
      "change": "Restored the short unmount entry and shared flush path, which closes open files. Removed busy-file restrictions, unconditional-unmount handling, desktop shutdown, and the extra close path for offline volumes.",
      "evidence": "At 0x4035b4 UnMountVol synchronizes, clears FlushOnly, and branches to the shared DtrmV3 call at 0x403604. The HFS path skips FlushBuffers when vcbDrvNum is zero, then disposes the VCB if unmounting. The source dates the busy-file and shutdown changes to November 4, 1987."
    },
    {
      "location": "FlushBuffers",
      "change": "Preserved the ROM behavior that clears VCBCTRef after each of the two control-file closes.",
      "evidence": "The instructions at 0x403488 and 0x40349c both clear offset 166, the catalog reference field. The second follows the extent-file close. This matches the surviving source; the reconstruction does not change the second clear to VCBXTRef."
    },
    {
      "location": "XferVName",
      "change": "Restored the 24-bit mask and pointer-bound comparison, replacing StripAddress. Used BufPtr for the bound shown in the ROM.",
      "evidence": "At 0x403abc the ROM applies Lo3Bytes at 0x031a. At 0x403ac0 it compares with BufPtr at 0x010c and skips copying if the pointer is greater. Inactive source lines retain the earlier check but name MemTop at 0x0108; the later active line calls StripAddress."
    },
    {
      "location": "PickWDCB",
      "change": "Restored selection by volume, directory, and caller ProcID, retaining the first available WDCB. Removed the Process Manager parallel records and ioWDCreated writes.",
      "evidence": "The ROM at 0x403bd2..0x403c1e reads ioWDProcID into D3, skips the two reserved entries, reuses a matching record, or fills the first free entry. It returns TMWDOErr when no entry is available. The surviving expanded body supplies the matching loop and applicable comments."
    },
    {
      "location": "Working-directory information and validation",
      "change": "Omitted the later D1 clear in GetWDCBInfo and the closed-WDCB pointer check in CkWDRefNum.",
      "evidence": "At 0x403c7a GetWDCBInfo reads only the reference-number word into D1. At 0x403d3c CkWDRefNum checks the index bounds and 16-byte record alignment, then reports success without checking WDVCBPtr. The source dates those additions to April 15 and September 15, 1986."
    },
    {
      "location": "Source form and provenance",
      "change": "Preserved the module description and applicable API comments and history. Restored the earlier entry names, selected branch widths shown by the ROM, made PC-relative calls explicit, and encoded the asynchronous Control variant directly.",
      "evidence": "Control emits opcode 0xa404. GetVolInfo retains the word branch at 0x403884. The restored FlVolStart name identifies the common entry at 0x403604. New notes identify the reconstructed code, and original inactive EX-CODE lines receive semicolon prefixes."
    }
  ],
