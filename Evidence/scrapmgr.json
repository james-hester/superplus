  "preserved_rom_behavior": [
    {
      "address": "0x416df0",
      "description": "The code uses scrapState zero for disk storage, positive for memory and negative for an uninitialized scrap. The original state-summary comment reverses disk and memory; it remains exact with a reconstruction note above it."
    },
    {
      "address": "0x416f56",
      "description": "PutScrap ignores the result of writing the object header and proceeds to write the payload. It stores the updated length even when the final write fails. The later rollback patches were not applied."
    },
    {
      "address": "0x416f68",
      "description": "PutScrap rounds the payload length up to an even byte count and passes that count with the original source pointer. An odd payload therefore includes the following byte in the stored padding."
    },
    {
      "address": "0x416f42",
      "description": "FailSafe branches directly to the shared error exit after ZeroScrap fails. The reconstruction preserves this control flow."
    },
    {
      "address": "0x416e98",
      "description": "ZeroScrap adds eight to the validation word and negates a negative result, preserving the original count arithmetic."
    }
  ],
