        MACRO
        ToolBox &num,&name ;]
        IF &name = '0' THEN ;]
        DC.L 0
        ELSE
        DC.L &name-BaseOfROM
        ENDIF
        ENDM

        MACRO
        OS &num,&name ;]
        IF &name = '0' THEN ;]
        DC.L 0
        ELSE
        DC.L &name-BaseOfROM
        ENDIF
        ENDM

