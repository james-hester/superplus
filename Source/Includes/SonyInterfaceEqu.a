*R MPW 1.0.1 supplies the complete 1986 Sony interface and DCD layout.
*R The Plus ROM leaves 12 bytes between TimeQEl and NextGZProc.
*R The released TimeEqu.a uses 14; this local value retains the ROM layout.

	IF (&TYPE('PlusSonyEquIncluded') = 'UNDEFINED') THEN ;]
PlusSonyEquIncluded EQU 1 ;]
SonyNonPortable EQU 1 ;]
	IF (&TYPE('onMac') = 'UNDEFINED') THEN ;]
onMac EQU 1 ;]
	ENDIF ;]
tmQSize EQU 12 ;]
	INCLUDE ':MPW1.0.1:SonyEqu.a' ;]

*R SuperMario Interfaces/AIncludes/SonyEqu.a supplies these later names.
; Copyright: © 1991-1993 by Apple Computer, Inc., all rights reserved.
firstDCD EQU 3
maxGCRSectors 	EQU 		12        				;12 GCR sectors/track side (max)
*R The Plus ROM supports two floppy drives and four DCD drives.
maxDrvNum EQU 6 ;]
	ENDIF ;]
