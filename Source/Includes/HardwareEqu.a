*R MPW 1.0.1 supplies the complete 1986 interface below.
*R Additional declarations retain the names used by the ROM sources.

	IF (&TYPE('PlusHardwareEquIncluded') = 'UNDEFINED') THEN ;]
PlusHardwareEquIncluded EQU 1 ;]
	INCLUDE 'SysEqu.a' ;]
HWNonPortable EQU 1 ;]
	INCLUDE ':MPW1.0.1:HardwareEqu.a' ;]

*R Additional declarations come from SuperMario Interfaces/AIncludes/HardwareEqu.a.
;               File:    HardwareEqu.a
;
;               Assembler Interface           to the Macintosh Libraries
;               Copyright Apple                 Computer, Inc. 1984-1990
;               All      Rights                                 Reserved
;
;
ifCA2           EQU      0                               ; CA2 interrupt
ifCA1           EQU      1                               ; CA1 interrupt
ifSR            EQU      2                      ; SR shift register done
Machine         EQU      0

	ENDIF ;]
