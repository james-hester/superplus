	INCLUDE 'Private.a' ;]

numOsTrap 		EQU 		256   					; number of os traps
numTrapMask EQU $1FF ;]
numTbTrap 		EQU 		512   					; number of toolbox traps
HeapStart 		EQU 		$1400 					; Mac Plus starting point
