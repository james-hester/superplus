*R MPW 1.0.1 supplies the complete 1986 interface below.
*R Additional declarations retain the names used by the ROM sources.

	IF (&TYPE('PlusSysErrIncluded') = 'UNDEFINED') THEN ;]
PlusSysErrIncluded EQU 1 ;]
wholeErrors EQU 1 ;]
	INCLUDE ':MPW1.0.1:SysErr.a' ;]

*R Additional declarations come from SuperMario Interfaces/AIncludes/SysErr.a.
; File:SysErr.a
;
; Assembler Interface to the Macintosh Libraries
; Copyright Apple Computer, Inc. 1984-1991
; All Rights Reserved
;
;
memROZWarn		EQU 		-99       				; soft error in ROZ
dsFinderErr   	EQU 		41        				; can’t load the Finder
dsMacsBugInstalled 		EQU		-10       			; say “MacsBug Installed”
dsDisassemblerInstalled	EQU		-11       			; say “Disassembler Installed”
dsGreeting		EQU 		40        				; welcome to Macintosh greeting

	ENDIF ;]
