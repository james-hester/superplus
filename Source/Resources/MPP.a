*R Mac Plus v3 embedded MPP driver, version 19.
*R The complete MPP, LAP, DDP, and NBP implementation sources were not found.
*R The ROM establishes the code; surviving interfaces establish public fields.
*R vardefs2.a and LAPvars2.a preserve most names and relationships in the private layout.
*R Their later table sizes and added fields have been restored to the ROM layout.
*R Other routine names and private fields are reconstruction identifiers.
*R The original VBLDeferCnt interrupt race remains.
*R Resource lengths, driver entries, and dispatch tables use label differences.

*R Surviving interface definitions and restored private layout.
		EXPORT MPPDriver ;]

		INCLUDE 'AppleTalk.a'
		INCLUDE 'Private.a'
		INCLUDE 'SysEqu.a'
		INCLUDE 'SysErr.a'
		INCLUDE 'Traps.a'

ControlFirst EQU LookupReply-1 ;]
; List of active protocols
Protocols EQU ATPVars+4 ;]
; Size of LAP protocol handler table (even)
LAPTblSz EQU 4 ;]
Handlers		EQU		Protocols+LAPTblSz 		; List of handler addresses
LAPTblEnd		EQU		Handlers+(4*LAPTblSz)	; End of LAP table
SocketNum		EQU		LAPTblEnd				; Socket number in socket table
; Size of socket table (even!)
DDPTblSz EQU 14 ;]
SktLstnr		EQU		SocketNum+DDPTblSz		; Socket listener addr
DDPTblEnd EQU SktLstnr+4*DDPTblSz ;]
VBLQEl			EQU		DDPTblEnd				; A VBL queue element
NRPtr			EQU		VBLQEl+14				; Ptr to non-resident code (and flag)
LookupPtr		EQU		NRPtr+4					; Pointer to lookup-reply code (and flag)
SCCLockout68000 EQU $2600 ;]
NRVars			EQU		LookupPtr+4				; Pointer to NR local variables
JDDPWrite		EQU		NRVars+4				; Address of DDPWrite routine
NTQueueHd		EQU		JDDPWrite+4				; Names Table Queue Head
LUQElPtr		EQU		NTQueueHd+4				; Ptr to lookup queue element/buffer
; End of MPP vars (*** more in LAPvars.a ***)
MPPVarsEnd EQU LUQElPtr+4 ;]
WDSPtr EQU MPPVarsEnd ; (4) WDS pointer saved here on writes
LAPWrtRtn		EQU		WDSPtr+4				; (4) LAP write return address saved here
RandomSeed		EQU		LAPWrtRtn+4				; (2) Seed for random number generator
DestNode		EQU		RandomSeed+2			; (1) Destination node saved here on writes
fLAPAdrValid	EQU		DestNode+1				; (1) If node address has been validated
fGoodCTS		EQU		fLAPAdrValid+1			; (1) If a valid CTS is received
fAdrInUse		EQU		fGoodCTS+1				; (1) If get something from ourselves
fSendENQ		EQU		fAdrInUse+1				; (1) Flag to AbusWrite to send ENQ (not data)
VBLDeferCnt		EQU		fSendENQ+1				; (1) Count for VBL deferring check
lbackOff		EQU		VBLDeferCnt+1			; (1) Local backoff mask for one send
backoff			EQU		lbackOff+1				; (1) Global backoff mask
collsnHistory	EQU		backoff+1				; (1) Bit history of collisions last 8 sends
deferHistory	EQU		collsnHistory+1			; (1) Bit history of defers last 8 sends
deferTries		EQU		deferHistory+1			; (1) Local count of defers in one send
collsnTries		EQU		deferTries+1			; (1) Local count of collisions in one send
BridgeTime		EQU		collsnTries+1			; (1) Timestamp since last router packet
SCCSyncHunt EQU 4 ;]
VAbortWait EQU BridgeTime+1 ;]
; (8) A4 and A5 saved here on interrupt
SaveA45 EQU VAbortWait+1 ;]
SaveDskRtn		EQU		SaveA45+8				; (4) DskRtnAdr saved here for PollProc
SavePS			EQU		SaveDskRtn+4			; (4) PollStack saved here for disk driver
SaveBIn			EQU		SavePS+4				; (4) .BIN DCE saved here (for close)
SaveBOut		EQU		SaveBIn+4				; (4) .BOUT DCE saved here (for close)
SaveVects		EQU		SaveBOut+4				; (12) SCC interrupt vectors saved here
SaveRegs		EQU		SaveVects+12			; (20) Registers saved here across PollProc
VAVBufA			EQU		SaveRegs+20				; Pointer to VIA or a $FF word
VSTData			EQU		VAVBufA+4				; Data string to SCC after send
VDisTxRTS		EQU		VSTData+1				; This is the DisTxRTS byte
VBL20			EQU		20						; Call VBL task every 20 ticks
SCCRxReady EQU 0 ;]
SCCTxReady EQU 2 ;]
SCCData EQU 4
STLth			EQU		6						; Size of STData area
DataSize EQU VSTData+STLth ;]
MacAVBufA EQU $EFFFFE ;]
MPPVersion EQU 19 ;]
LookupReadSize EQU $7C ;]
NBPVarSize EQU $47 ;]
NBPVBLQ EQU 4 ;]
LookupBufferSize EQU $98 ;]
NBPRetBuffer EQU $16 ;]
NBPRetLength EQU $1A ;]
NBPRequest EQU $12 ;]
NBPDestNet EQU 2 ;]
NBPDDPHeader EQU $37 ;]
NBPHeader EQU $30 ;]
NBPRequestID EQU 1 ;]
NBPWDS EQU $1C ;]
CmpStringTrap EQU $A03C ;]
SCCReadEnable EQU $2100 ;]


MPPResourceBlock PROC ;]
 DC.L $C0000000+(MPPResourceEnd-MPPResourceBlock) ;]
 DC.L $64 ;]

MPPDriver ;]
 DC.W $5C00
 DC.W 0,0,0
 DC.W MPPOpen-MPPDriver ;]
 DC.W MPPPrime-MPPDriver ;]
 DC.W MPPControl-MPPDriver ;]
 DC.W MPPStatus-MPPDriver ;]
 DC.W MPPClose-MPPDriver ;]
 DC.B 4
 DC.B '.MPP '

*R This is the conventional driver-version slot; the high byte and use are unproven.

MPPVersionWord ;]
 DC.W $2813

MPPControl ;]
 MOVE.L     AtalkHk1,D3 ;]
 BLE.S      DispatchMPP ;]
 MOVE.L     D3,A2
 JSR        (A2)

DispatchMPP ;]
 MOVE.L     ABusVars,A2
 MOVE.L     A2,D0
 BNE.S      MPPBranch_41a72c ;]
 MOVEQ      #ControlErr,D0
 BRA.W      GoIODone ;]

MPPBranch_41a72c ;]
 MOVE.W     CSCode(A0),D3 ;]
 BMI.S      CloseForApplication ;]
 SUBQ.W     #1,D3
 BNE.S      MPPBranch_41a738 ;]
 RTS        

MPPBranch_41a738 ;]
 MOVEQ      #ControlErr,D0
 SUB.W      #ControlFirst,D3 ;]
 BLT.W      GoIODone ;]
 CMP.W      #UnloadNBP-LookupReply,D3 ;]
 BGT.W      GoIODone ;]
 MOVE.B     Socket(A0),D1
 MOVE.L     WDSPointer(A0),A1 ;]
 CMP.W      #LoadNBP-LookupReply,D3 ;]
 BGT.S      CallNBP ;]
 LEA        MPPControlTable,A3 ;]
 ADD.W      D3,A3
 ADD.W      D3,A3
 MOVE.W     (A3),A3 ;]
 PEA        MPPDriver ;]
 ADD.L      (SP)+,A3 ;]
 JMP        (A3)

MPPControlTable ;]
 DC.W DoLookupReply-MPPDriver ;]
 DC.W DoWriteLAP-MPPDriver ;]
 DC.W DoDetachPH-MPPDriver ;]
 DC.W DoAttachPH-MPPDriver ;]
 DC.W DoWriteDDP-MPPDriver ;]
 DC.W DoCloseSkt-MPPDriver ;]
 DC.W DoOpenSkt-MPPDriver ;]
 DC.W NoError-MPPDriver ;]

CloseForApplication ;]
 MOVE.L     LookupPtr(A2),D1 ;]
 BPL.S      CallNBP ;]
 MOVE.L     D1,A3
 JSR        2(A3) ;]

CallNBP ;]
 MOVE.L     NRPtr(A2),D2 ;]
 BPL.S      MPPExit ;]
 MOVE.L     D2,A3
 JMP        (A3)

DoLookupReply ;]
 MOVE.L     LookupPtr(A2),D2 ;]
 BPL.S      MPPExit ;]
 MOVE.L     D2,A3
 JMP        (A3)

NoError
 CLR.W      D0

MPPExit ;]
 BRA.W      FinishMPP ;]

EnableNBP ;]
 LEA        NBPCode,A3 ;]
 MOVE.L     A3,NRPtr(A2) ;]
 BSET       #7,NRPtr(A2) ;]
 JMP        (A3)

DoOpenSkt ;]
 BSR.S      DDPOpenSocket ;]
 MOVE.B     D1,Socket(A0) ;]
 BRA.S      MPPBranch_41a80a ;]

DDPOpenSocket
 MOVEQ      #DDPSktErr,D0 ;]
 MOVE.W     SR,-(SP)
 MOVE.W     #SCCLockout68000,SR ;]
 TST.B      D1
 BEQ.S      MPPBranch_41a7ca ;]
 BMI.S      MPPBranch_41a7f6 ;]
 BSR.S      FindSocket ;]
 BEQ.S      MPPBranch_41a7f6 ;]

MPPBranch_41a7ca ;]
 MOVEQ      #DDPTblSz-1,D2 ;]

MPPBranch_41a7cc ;]
 TST.B      SocketNum(A2,D2.W) ;]
 DBEQ       D2,MPPBranch_41a7cc ;]
 BNE.S      MPPBranch_41a7f6 ;]
 TST.B      D1
 BNE.S      MPPBranch_41a7ea ;]
 BSR.W      NextRandom ;]
 AND.B      #$F0,D0
 OR.B       D2,D0
 BSET       #7,D0
 MOVE.B     D0,D1

MPPBranch_41a7ea ;]
 MOVE.B     D1,SocketNum(A2,D2.W) ;]
 LSL.W      #2,D2
 MOVE.L     A1,SktLstnr(A2,D2.W) ;]
 CLR.W      D0

MPPBranch_41a7f6 ;]
 MOVE.W     (SP)+,SR
 RTS        

DoCloseSkt ;]
 MOVEQ      #DDPSktErr,D0 ;]
 TST.B      D1
 BEQ.S      MPPBranch_41a80a ;]
 BSR.S      FindSocket ;]
 BNE.S      MPPBranch_41a80a ;]
 CLR.B      SocketNum(A2,D2.W) ;]
 CLR.W      D0

MPPBranch_41a80a ;]
 BRA.S      MPPExit ;]

FindSocket ;]
 MOVEQ      #DDPTblSz-1,D2 ;]

MPPBranch_41a80e ;]
 CMP.B      SocketNum(A2,D2.W),D1 ;]
 DBEQ       D2,MPPBranch_41a80e ;]
 RTS        

DoWriteDDP ;]
 MOVE.B     CheckSumFlag(A0),D3 ;]
 BSR.S      DDPWrite ;]
 BRA.S      MPPBranch_41a80a ;]

DDPWrite
 BRA.S      WriteDDPPacket ;]

DDPOpenEntry ;]
 BRA.S      DDPOpenSocket ;]

WriteDDPPacket ;]
 MOVEQ      #DDPSktErr,D0 ;]
 TST.B      D1
 BEQ.S      MPPBranch_41a892 ;]
 BSR.S      FindSocket ;]
 BNE.S      MPPBranch_41a892 ;]
 MOVE.L     A1,-(SP)
 ADDQ.W     #2,A1
 MOVE.L     (A1)+,A3 ;]
 ADDQ.W     #7,A3 ;]
 MOVE.B     D1,7(A3) ;]
 MOVE.W     (A3),D0
 BEQ.S      MPPBranch_41a894 ;]
 CMP.W      SysNetNum(A2),D0 ;]
 BEQ.S      MPPBranch_41a894 ;]
 MOVE.W     SysNetNum(A2),2(A3) ;]
 MOVE.B     (A2),5(A3) ;]
 MOVE.B     4(A3),D1 ;]
 MOVE.L     A3,A0
 CLR.W      -(A3)
 TST.B      D3
 BEQ.S      MPPBranch_41a870 ;]
 MOVEQ      #9,D0
 CLR.W      D3
 BSR.S      DDPChecksum ;]

MPPBranch_41a860 ;]
 MOVE.W     (A1)+,D0
 BEQ.S      MPPBranch_41a86a ;]
 MOVE.L     (A1)+,A0
 BSR.S      DDPChecksum ;]
 BRA.S      MPPBranch_41a860 ;]

MPPBranch_41a86a ;]
 MOVE.W     D3,(A3)
 BNE.S      MPPBranch_41a870 ;]
 SUBQ.W     #1,(A3) ;]

MPPBranch_41a870 ;]
 MOVEQ      #2,D3
 MOVEQ      #16,D0
 MOVE.B     SysABridge(A2),D2 ;]
 BNE.S      MPPBranch_41a8a4 ;]
 MOVE.B     D1,D2
 TST.W      SysNetNum(A2) ;]
 BEQ.S      MPPBranch_41a8a4 ;]
 MOVEQ      #NoBridgeErr,D0 ;]
 ADDQ.W     #4,SP
 RTS        

DDPChecksum
 MOVE.B     (A0)+,D2
 ADD.W      D2,D3
 ROL.W      #1,D3
 SUBQ.W     #1,D0
 BNE.S      DDPChecksum ;]

MPPBranch_41a892 ;]
 RTS        

MPPBranch_41a894 ;]
 MOVE.L     A3,A0
 ADDQ.W     #8,A0
 MOVE.B     (A0),(A3) ;]
 MOVE.W     -(A0),-(A3) ;]
 SUBQ.W     #2,A0
 MOVE.B     (A0),D2
 MOVEQ      #1,D3
 MOVEQ      #8,D0

MPPBranch_41a8a4 ;]
 MOVE.L     (SP)+,A1
 MOVE.W     D0,(A1)
 CLR.W      D1
 MOVE.L     A1,A0

MPPBranch_41a8ac ;]
 TST.W      (A0)
 BEQ.S      MPPBranch_41a8b8 ;]
 BMI.S      MPPBranch_41a8ce ;]
 ADD.W      (A0),D1 ;]
 ADDQ.W     #6,A0
 BRA.S      MPPBranch_41a8ac ;]

MPPBranch_41a8b8 ;]
 MOVE.W     D1,-(A3) ;]
 SUBQ.W     #3,(A3) ;]
 SUB.W      D0,D1
 CMP.W      #DDPMaxData,D1 ;]
 BHI.S      MPPBranch_41a8ce ;]
 MOVE.B     D3,-(A3) ;]
 SUBQ.W     #2,A3
 MOVE.B     D2,(A3)
 BRA.W      AbusWrite ;]

MPPBranch_41a8ce ;]
 MOVEQ      #DDPLenErr,D0
 BRA.S      MPPBranch_41a892 ;]

ReadLongDDP ;]
 MOVEQ      #11,D3 ;]
 MOVE.W     SysNetNum(A2),D2
 JSR        (A4)
 BNE.S      MPPBranch_41a892 ;]
 CMP.W      8(A2),D2 ;]
 BEQ.S      DispatchDDP ;]
 BRA.S      IgnoreDDP ;]

ReadShortDDP ;]
 MOVEQ      #3,D3
 JSR        (A4)
 BNE.S      MPPBranch_41a892 ;]
*R Surviving interface contract for the socket listener called below.
;	This socket listener is called from MPP.
;
;	Upon entering the socket listener, the LAP header bytes, and the
;	appropriate DDP header bytes have been written into the RHA and the
;	RHA's ptr will point past the last byte in the RHA.
;
;	A4 and A5 are usable until ReadRest 2(A4) is called.  After that,
;	the normal interrupt conventions (A0-A3,D0-D3) apply.	D2 is
;	preserved across ReadPacket and ReadRest.

DispatchDDP ;]
 MOVEQ      #DDPTblSz-1,D2 ;]
 MOVE.B     -3(A3),D0 ;]
 BEQ.S      IgnoreDDP ;]

MPPBranch_41a8f2 ;]
 CMP.B      SocketNum(A2,D2.W),D0 ;]
 DBEQ       D2,MPPBranch_41a8f2 ;]
 BNE.S      IgnoreDDP ;]
 LSL.W      #2,D2
 MOVE.L     SktLstnr(A2,D2.W),A5 ;]
 JMP        (A5)

IgnoreDDP ;]
 JMP        2(A4)

RTMPRead ;]
 SUBQ.B     #1,-(A3) ;]
 BNE.S      IgnoreDDP ;]
 MOVEQ      #4,D3
 JSR        2(A4)
 BNE.S      MPPBranch_41a926 ;]
 MOVE.B     -(A3),D2 ;]
 SUBQ.B     #8,-(A3) ;]
 BNE.S      MPPBranch_41a926 ;]
 MOVE.B     D2,SysABridge(A2) ;]
 ST         BridgeTime(A2) ;]
 MOVE.W     -(A3),SysNetNum(A2) ;]

MPPBranch_41a926 ;]
 RTS        

DoAttachPH
 MOVEQ      #LAPProtErr,D0
 TST.B      D1
 BLE.S      MPPBranch_41a94a ;]
 BSR.S      FindProtocol ;]
 BEQ.S      MPPBranch_41a94a ;]
 MOVEQ      #LAPTblSz-1,D2

MPPBranch_41a934 ;]
 LEA        Protocols(A2,D2.W),A3 ;]
 TST.B      (A3)
 DBMI       D2,MPPBranch_41a934 ;]
 BPL.S      MPPBranch_41a94a ;]
 LSL.W      #2,D2
 MOVE.L     A1,Handlers(A2,D2.W) ;]
 MOVE.B     D1,(A3)

MPPBranch_41a948 ;]
 CLR.W      D0

MPPBranch_41a94a ;]
 BRA.S      FinishMPP ;]

FindProtocol ;]
 MOVEQ      #LAPTblSz-1,D2

MPPBranch_41a94e ;]
 CMP.B      Protocols(A2,D2.W),D1 ;]
 DBEQ       D2,MPPBranch_41a94e ;]
 RTS        

DoDetachPH
 MOVEQ      #LAPProtErr,D0
 MOVEQ      #LAPTblSz-1,D2

MPPBranch_41a95c ;]
 CMP.B      Protocols(A2,D2.W),D1 ;]
 DBEQ       D2,MPPBranch_41a95c ;]
 BNE.S      MPPBranch_41a94a ;]
 ST         Protocols(A2,D2.W) ;]
 BRA.S      MPPBranch_41a948 ;]

DoWriteLAP ;]
 MOVE.L     2(A1),A0 ;]
 MOVEQ      #LAPProtErr,D0
 TST.B      2(A0)
 BLE.S      MPPBranch_41a94a ;]
 MOVE.B     (A0),D2
 BSR.S      AbusWrite ;]
 BRA.S      FinishMPP ;]

MPPStatus ;]
 MOVEQ      #StatusErr,D0

FinishMPP ;]
 MOVE.L     ABusDCE,A1 ;]

GoIODone
 MOVE.L     JIODone,-(SP)
 RTS        

MPPPrime ;]
 BCLR       #7,DCtlFlags+1(A1) ;]
 RTS        

AbusWrite ;]
 CLR.B      fSendENQ(A2) ;]
 MOVE.L     A1,WDSPtr(A2) ;]

AbusSend ;]
 MOVE.L     (SP)+,LAPWrtRtn(A2) ;]
 MOVE.L     AtalkHk2,D3 ;]
 BLE.S      MPPBranch_41a9a8 ;]
 MOVE.L     D3,A3
 JSR        (A3)

MPPBranch_41a9a8 ;]
 MOVE.B     D2,DestNode(A2) ;]
 LEA        backoff(A2),A3 ;]
 MOVE.B     (A3)+,D3
 MOVE.B     (A3),D2
 ADD.B      D2,(A3)+ ;]
 BSR.S      CountHistoryBits ;]
 BLE.S      MPPBranch_41a9da ;]
 ADD.B      D3,D3
 ADDQ.B     #1,D3
 AND.W      #15,D3
 CLR.B      -1(A3)
 BRA.S      MPPBranch_41a9e4 ;]

CountHistoryBits ;]
 MOVEQ      #0,D0
 MOVEQ      #7,D1

MPPBranch_41a9cc ;]
 BTST       D1,D2
 BEQ.S      MPPBranch_41a9d2 ;]
 ADDQ.W     #1,D0

MPPBranch_41a9d2 ;]
 DBRA       D1,MPPBranch_41a9cc ;]
 SUBQ.B     #2,D0
 RTS        

MPPBranch_41a9da ;]
 MOVE.B     (A3),D2
 BSR.S      CountHistoryBits ;]
 BGE.S      MPPBranch_41a9e4 ;]
 LSR.B      #1,D3
 ST         (A3) ;]

MPPBranch_41a9e4 ;]
 MOVE.B     (A3),D2
 ADD.B      D2,(A3)+ ;]
 MOVEQ      #32,D0
 MOVE.B     D0,(A3)+
 MOVE.B     D0,(A3)
 SUBQ.W     #5,A3 ;]
 MOVE.B     D3,(A3)+
 MOVE.B     D3,(A3)+
 MOVEM.L    SCCRd,A0-A1 ;]

MPPBranch_41a9fa ;]
 MOVE.W     SR,-(SP)

MPPBranch_41a9fc ;]
 MOVE.W     D0,D3
 BTST       #SCCSyncHunt,(A0) ;]
 BEQ.S      MPPBranch_41aa32 ;]
 BSR.W      NextRandom ;]
 AND.B      lbackOff(A2),D0 ;]
 AND.W      #15,D0
 MOVE.W     D0,D3
 BEQ.S      MPPBranch_41aa1c ;]

MPPBranch_41aa14 ;]
 BSR.S      WaitIdleSlot ;]
 BEQ.S      MPPBranch_41aa32 ;]
 SUBQ.W     #1,D0
 BNE.S      MPPBranch_41aa14 ;]

MPPBranch_41aa1c ;]
 MOVE.W     #SCCLockout68000,SR ;]
 MOVE.B     #14,(A1) ;]
 MOVEQ      #3,D0
 ADDQ.W     #3,D3 ;]
 MOVE.B     #65,(A1) ;]

MPPBranch_41aa2c ;]
 BSR.S      WaitIdleSlot ;]
 DBEQ       D0,MPPBranch_41aa2c ;]

MPPBranch_41aa32 ;]
 BEQ.W      MPPBranch_41aac4 ;]
 MOVE.B     #10,(A1) ;]
 MOVE.B     DestNode(A2),D2 ;]
 TST.B      (A0)
 BMI.W      MPPBranch_41aac4 ;]
 MOVE.B     #5,(A1) ;]
 MOVEQ      #-124,D0 ;]
 MOVE.B     #98,(A1) ;]
 TST.B      fSendENQ(A2) ;]
 BEQ.S      MPPBranch_41aa56 ;]
 MOVEQ      #-127,D0 ;]

MPPBranch_41aa56 ;]
 MOVE.B     #5,(A1) ;]
 NOP        
 MOVE.B     VDisTxRTS(A2),(A1) ;]
 BSR.W      SendControlFrame ;]
 ADDQ.B     #1,D2
 BEQ.S      MPPBranch_41aa92 ;]
 CLR.B      fGoodCTS(A2) ;]
 BSR.W      GetControlFrame ;]
 TST.B      fSendENQ(A2) ;]
 BEQ.S      MPPBranch_41aa7e ;]
 TST.B      fAdrInUse(A2) ;]
 BEQ.S      Collision ;]
 BRA.S      LAPSuccess ;]

MPPBranch_41aa7e ;]
 TST.B      fGoodCTS(A2) ;]
 BEQ.S      Collision ;]
 BRA.S      SendDataFrame ;]

WaitIdleSlot ;]
 MOVEQ      #60,D1

MPPBranch_41aa88 ;]
 DBRA       D1,MPPBranch_41aa88 ;]
 BTST       #SCCSyncHunt,(A0) ;]
 RTS        

MPPBranch_41aa92 ;]
 BSR.S      WaitIdleSlot ;]
 BEQ.S      Collision ;]

SendDataFrame ;]
 BSR.W      WritePacket ;]

LAPSuccess ;]
 MOVEQ      #0,D0

LAPReturn ;]
 MOVE.W     (SP)+,SR
 MOVE.L     LAPWrtRtn(A2),A0 ;]
 JMP        (A0)

Collision ;]
 MOVE.W     (SP),SR
 BSET       #0,collsnHistory(A2) ;]
 MOVE.B     lbackOff(A2),D0 ;]
 ADD.B      D0,D0
 ADDQ.B     #1,D0
 MOVE.B     D0,lbackOff(A2) ;]
 MOVEQ      #ExcessCollsns,D0 ;]
 SUBQ.B     #1,collsnTries(A2) ;]
 BEQ.S      LAPReturn ;]
 BRA.W      MPPBranch_41a9fc ;]

MPPBranch_41aac4 ;]
 SUB.W      D0,D3
 SUBQ.W     #4,D3
 BLT.S      MPPBranch_41aade ;]
 MOVEQ      #ExcessCollsns,D0 ;]
 SUBQ.B     #1,deferTries(A2) ;]
 BEQ.S      LAPReturn ;]
 BSET       #0,lbackOff(A2) ;]
 BSET       #0,deferHistory(A2) ;]

MPPBranch_41aade ;]
 MOVE.W     #SCCLockout68000,SR ;]
 MOVE.B     #15,(A1)
 MOVEQ      #-120,D0
 MOVE.B     D0,(A1)
 ADDQ.B     #2,VBLDeferCnt(A2) ;]
