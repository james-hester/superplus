*R SANE macros and interface fields used by Mac Plus PACK 5.
*R Definitions and comments come from SANEMacs.a, SysEqu.a, ToolUtils.a and Traps.a.
*R FADDX uses CLR.W to encode the zero selector exactly as the ROM does.
*R The corresponding released macro uses MOVE.W #FFEXT+FOADD,-(SP).

; File: SANEMacs.a
;
; Copyright Apple Computer, Inc. 1984, 1985, 1986, 1987, 1989, 1990, 1991
; All Rights Reserved
;
; SANE Numerics -- This file defines the assembly language
; access to the 68K floating-point arithmetic routines. It is
; documented in the Apple Numerics Manual.
;
;************************************************************
; CHANGE LOG (relative to MPW 3.1 release)
;
;	16 Nov 89	JPO		Added macros for operations involving
;							96-bit extended format (Ω SANE)
;   27 Mar 90	JPO		Changed 96-bit extended opcodes for PACK 4
;							routines (bit 5 set instead of bit 7)
;	29 Mar 90	JPO		Added macro FCLASSC (classify comp)
;************************************************************
;———————————————————————————————————————————————————————————

		INCLUDE 'SANEMacs.a'
		INCLUDE 'SysEqu.a'
		INCLUDE 'ToolUtils.a'
		INCLUDE 'Traps.a'


				MACRO
				FADDX
                CLR.W       -(SP)
				_FP68K
				ENDM

				MACRO
				FSUBX
				MOVE.W		#FFEXT+FOSUB,-(SP)
				_FP68K
				ENDM

				MACRO
				FMULX
				MOVE.W		#FFEXT+FOMUL,-(SP)
				_FP68K
				ENDM

				MACRO
				FDIVX
				MOVE.W		#FFEXT+FODIV,-(SP)
				_FP68K
				ENDM

				MACRO
				FRINTX
				MOVE.W		#FORTI,-(SP)
				_FP68K
				ENDM

				MACRO
				FREMX
				MOVE.W		#FFEXT+FOREM,-(SP)
				_FP68K
				ENDM

				MACRO
				FLOGBX
				MOVE.W		#FOLOGB,-(SP)
				_FP68K
				ENDM

				MACRO
				FSCALBX
				MOVE.W		#FFINT+FOSCALB,-(SP)
				_FP68K
				ENDM

				MACRO
				FX2X
				MOVE.W		#FFEXT+FOZ2X,-(SP)
				_FP68K
				ENDM

				MACRO
				FI2X
				MOVE.W		#FFINT+FOZ2X,-(SP)
				_FP68K
				ENDM

				MACRO
				FX2I
				MOVE.W		#FFINT+FOX2Z,-(SP)
				_FP68K
				ENDM

				MACRO
				FCMPX
				MOVE.W		#FFEXT+FOCMP,-(SP)
				_FP68K
				ENDM

				MACRO
				FBEQL
				BEQ 		&SYSLIST[1]
				ENDM

				MACRO
				FBGTL
				BGT 		&SYSLIST[1]
				ENDM

				MACRO
				FBULTL
				BLT 		&SYSLIST[1]
				ENDM

				MACRO
				FBULEL
				BLE 		&SYSLIST[1]
				ENDM

				MACRO
				FBEQS
				BEQ.S		&SYSLIST[1]
				ENDM

				MACRO
				FBLTS
				BCS.S		&SYSLIST[1]
				ENDM

				MACRO
				FBLES
				BLS.S		&SYSLIST[1]
				ENDM

				MACRO
				FBGTS
				BGT.S		&SYSLIST[1]
				ENDM

				MACRO
				FBGES
				BGE.S		&SYSLIST[1]
				ENDM

				MACRO
				FBULTS
				BLT.S		&SYSLIST[1]
				ENDM

				MACRO
				FBULES
				BLE.S		&SYSLIST[1]
				ENDM

				MACRO
				FBUGTS
				BHI.S		&SYSLIST[1]
				ENDM

				MACRO
				FBNES
				BNE.S		&SYSLIST[1]
				ENDM

				MACRO
				FCLASSX
				MOVE.W		#FFEXT+FOCLASS,-(SP)
				_FP68K
				ENDM

				MACRO
				FGETENV
				MOVE.W		#FOGETENV,-(SP)
				_FP68K
				ENDM

				MACRO
				FSETENV
				MOVE.W		#FOSETENV,-(SP)
				_FP68K
				ENDM

				MACRO
				FTESTXCP
				MOVE.W		#FOTESTXCP,-(SP)
				_FP68K
				ENDM

				MACRO
				FSETXCP
				MOVE.W		#FOSETXCP,-(SP)
				_FP68K
				ENDM

				MACRO
				FPROCENTRY
				MOVE.W		#FOPROCENTRY,-(SP)
				_FP68K
				ENDM

				MACRO
				FPROCEXIT
				MOVE.W		#FOPROCEXIT,-(SP)
				_FP68K
				ENDM

